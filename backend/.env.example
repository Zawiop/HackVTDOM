# Copy to backend/.env and fill in. NEVER commit the real .env.

# --- Step 01: Nominatim (no key; the User-Agent IS the auth) ---
# Nominatim rejects generic library user agents. Put a real contact address here.
NOMINATIM_USER_AGENT="ScorchedNebraskaVTHacks/1.0 (you@vt.edu)"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"

# --- Step 02: Overpass (no key) ---
OVERPASS_PRIMARY_URL="https://overpass-api.de/api/interpreter"
OVERPASS_MIRROR_URL="https://overpass.kumi.systems/api/interpreter"
OVERPASS_BACKOFF_SECONDS=30
# Optional, defaults shown:
#   OVERPASS_TIMEOUT_SECONDS=25
#   OVERPASS_MATCH_RADIUS_METERS=50      which building is at this point
#   OVERPASS_NEIGHBOR_RADIUS_METERS=250  the wider pull steps 08/10 reuse
#   NOMINATIM_MIN_INTERVAL_SECONDS=1.0   Nominatim's policy cap is 1 req/sec
#   FOOTPRINT_CACHE_PATH=.cache/footprints.json
#   CORS_ORIGINS=["http://localhost:5173"]

# --- Step 03: Mapillary street-level imagery (free, registration only) ---
MAPILLARY_ACCESS_TOKEN=""

# --- Step 05: Google Gemini image model ---
# NOTE: free-tier keys currently get limit 0 for image models; generation falls through to the
# FLUX.1 Kontext HF Space (uses HF_TOKEN). See STATUS.md.
GEMINI_API_KEY=""

# --- Steps 05/06: Hugging Face Spaces (Kontext image edit, SF3D/TripoSR mesh).
# Free token; the Spaces bill its daily ZeroGPU quota, and anonymous quota is much smaller. ---
HF_TOKEN=""

# --- Steps 05-07 optional tuning (defaults shown) ---
# PUBLIC_BASE_URL="http://localhost:8000"   # prefix for returned imageUrl/meshUrl
# IMAGE_PROVIDERS="gemini,kontext"
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# IMAGE_TIMEOUT_S=60
# MESH_PROVIDERS="triposr,sf3d"
# MESH_ATTEMPT_TIMEOUT_S=75
# MESH_RETRIES=1
# DEFAULT_FOOTPRINT_M=20                    # mesh size when no footprint is passed
# DEBUG_VIEWER=1                            # serve tests/viewer at /debug (orientation check page)

# --- Step 11: Supabase. BOTH are required to use the Supabase store. ---
# SUPABASE_URL is the project URL, e.g. https://abcdefghijkl.supabase.co
# Find it in: Supabase dashboard -> Project Settings -> Data API -> Project URL
# If either is empty the backend falls back to a local SQLite file (backend/local.db)
# with identical schema and semantics.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Optional overrides:
#   SN_STORE=sqlite|supabase    force a backend regardless of the above
#   SN_SQLITE_PATH=/path/to.db  where the local fallback database lives
