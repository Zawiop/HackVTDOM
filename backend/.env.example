# Copy to backend/.env and fill in. NEVER commit the real .env.

# Step 01 — Nominatim requires a real, identifying User-Agent or it rejects you.
NOMINATIM_USER_AGENT=ScorchedNebraskaVTHacks/1.0 (you@vt.edu)

# Step 05 — Gemini image editing (free tier, no card).
GEMINI_API_KEY=

# Step 03 — Mapillary street-level imagery (free, registration only).
MAPILLARY_ACCESS_TOKEN=

# Step 06 — Hugging Face token for the TripoSR Space (optional; without it you
# share the anonymous rate limit).
HF_TOKEN=

# Step 11 — Supabase. BOTH are required to use the Supabase store.
# SUPABASE_URL is the project URL, e.g. https://abcdefghijkl.supabase.co
# Find it in: Supabase dashboard -> Project Settings -> Data API -> Project URL
# If SUPABASE_URL is empty the backend falls back to a local SQLite file
# (backend/local.db) with identical schema and semantics.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional overrides:
#   SN_STORE=sqlite|supabase   force a backend regardless of the above
#   SN_SQLITE_PATH=/path/to.db  where the local fallback database lives
