# Copy to backend/.env and fill in. NEVER commit the real .env.

# --- Step 01: Nominatim (no key; the User-Agent IS the auth) ---
# Nominatim blocks generic library user agents. Put a real contact address here.
NOMINATIM_USER_AGENT="ScorchedNebraskaVTHacks/1.0 (your-team@email.com)"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"

# --- Step 02: Overpass (no key) ---
OVERPASS_PRIMARY_URL="https://overpass-api.de/api/interpreter"
OVERPASS_MIRROR_URL="https://overpass.kumi.systems/api/interpreter"
OVERPASS_BACKOFF_SECONDS=30

# --- Step 03: Mapillary (free registration token) ---
MAPILLARY_ACCESS_TOKEN=""

# --- Step 05: Google Gemini image model (free tier, no card) ---
GEMINI_API_KEY=""

# --- Step 06: Hugging Face / TripoSR Space (optional, raises anon rate limit) ---
HF_TOKEN=""

# --- Step 11: Supabase persistence ---
# SUPABASE_URL is the project URL, e.g. https://abcdefghijkl.supabase.co
# Find it in: Supabase dashboard -> Project Settings -> Data API -> Project URL
# Leave it empty and the backend falls back to a local SQLite file
# (backend/local.db) with an identical schema and identical semantics.
SUPABASE_URL=""
# Either spelling is accepted; the secret/service-role key bypasses RLS.
SUPABASE_SECRET_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# --- Optional store overrides ---
# SN_STORE=sqlite|supabase    force a backend regardless of the above
# SN_SQLITE_PATH=/path/to.db  where the local fallback database lives
