# Copy to backend/.env and fill in. Never commit the real file.

PORT=8787

# Spec 01 — Nominatim rejects generic library user agents.
NOMINATIM_USER_AGENT=ScorchedNebraskaVTHacks/1.0 (team@example.com)

# Spec 03 — free registration at mapillary.com, no billing.
MAPILLARY_ACCESS_TOKEN=

# Spec 05 — free tier at aistudio.google.com, no card.
GEMINI_API_KEY=

# Spec 06 — free Hugging Face account token (optional, relaxes rate limiting).
HF_TOKEN=

# Spec 11 — Supabase free tier.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
