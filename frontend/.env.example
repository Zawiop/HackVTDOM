# Copy to frontend/.env and fill in. NEVER commit the real .env.
# Only VITE_-prefixed vars reach the browser — never put a secret key here.
#
# Leave VITE_API_BASE_URL empty to use Vite's /api proxy (see vite.config.ts),
# which is the normal setup. Set it only when the backend is on another host.
VITE_API_BASE_URL=

# Supabase is read through the backend, so these are only needed if a component
# queries Supabase directly (nothing does today). Publishable/anon key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leave unset on the public Vercel build. The real access control is on the
# backend (ADMIN_TOKEN in backend/.env.example) — this one only decides
# whether THIS build shows the "reset world" / "remove" buttons at all. It
# ships inside the JS bundle like every VITE_ var, so it is visible to anyone
# who opens dev tools; it is not a secret, just a switch for whether the
# destructive UI renders. Set it to the same value as the backend's
# ADMIN_TOKEN only for a build your own team uses.
VITE_ADMIN_TOKEN=
