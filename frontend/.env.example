# Copy to frontend/.env and fill in. NEVER commit the real .env.
# Only VITE_-prefixed vars reach the browser — never put a secret key here.
#
# Leave VITE_API_BASE_URL empty to use Vite's /api proxy (see vite.config.ts),
# which is the normal setup. Set it only when the backend is on another host.
VITE_API_BASE_URL=

# Supabase is read through the backend, so these are only needed if a component
# queries Supabase directly (nothing does today). Publishable/anon key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
