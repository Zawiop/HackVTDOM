# Copy to frontend/.env and fill in. NEVER commit the real .env.

# Where the backend lives. Defaults to http://127.0.0.1:8000 when unset.
VITE_API_BASE_URL="http://127.0.0.1:8000"

# Only needed if a component ever queries Supabase directly. Nothing does
# today — all persistence goes through the backend.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
